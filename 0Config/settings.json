{
    "*.snippets": {
        "hltaberrors": false,
        "keepautoindent": true,
        "rmtrailingws": false,
        "tabsize": 4,
        "tabstospaces": false,
    },
    "basename": true,
    "colorcolumn": 79,
    "colorscheme": "CHXDark",
    "diffgutter": true,
    "divchars": "┆-",
    "ft:markdown": {
        "rmtrailingws": false,
        "wordwrap": true,
    },
    "ft:pascal": {
        "comment.type": "// %s",
    },
    "hlsearch": true,
    "hltaberrors": true,
    "hltrailingws": true,
    "matchbracestyle": "highlight",
    "parsecursor": true,
    "rmtrailingws": true,
    "scrollbar": true,
    "scrollbarchar": "┆",
    "showchars": "tab=⟩,space=,itab=┆⟩,ispace=┆",
    "softwrap": true,
    "wordwrap": false,
    "statusformatl": "┆$(lines)┆$(col)┆$(opt:encoding)┆$(opt:filetype)┆$(CHXStatusExt.GitRelDir)/",
    "statusformatr": "┆$(CHXStatusExt.FileElapTime)💾",
    "tabmovement": true,
    "tabsize": 2,
    "tabstospaces": true,
}

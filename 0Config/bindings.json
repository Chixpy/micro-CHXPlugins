 {
  // Warning:
  //   "Alt-Shift-<Key>", at least, doesn't work for me
  //   They must be: "Alt-<CapKey>" althought is less clear

  "Alt-w": "command:togglelocal softwrap",
  "Alt-W": "command:togglelocal wordwrap",

  "Alt-z": "IndentSelection|IndentLine",

  "Alt-P": "lua:CHXFPCCheck.CHXFPCCheck",

  "Alt-l": "lua:CHXFastSearch.CHXNextWord",
  "Alt-k": "lua:CHXFastSearch.CHXPrevWord",

  "Alt-s": "lua:CHXSplitLines.CHXSplitLines",
  "Alt-a": "lua:CHXSplitLines.CHXSplitLinesAt",
  "Alt-S": "lua:CHXSplitLines.CHXJustifyLine",
  "Alt-J": "lua:CHXSplitLines.CHXJustifyParagraph",
  // "\x1b " = Alt-Space in my terminal
  "\x1b ": "lua:CHXSplitLines.CHXNBSP",

  "Alt-C": "lua:CHXTemplates.CHXInsTemp",
  "Alt-N": "lua:CHXTemplates.CHXNextPH",
}

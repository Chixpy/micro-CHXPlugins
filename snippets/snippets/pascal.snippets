# Snippets for `snippets` plugin of `micro` editor
#
# Snippets are very verbose (with begin..end). On larger ones; if something
# is not needed, delete it.
#
# I thinked using templates that writes shortcuts to another ones, but I
# prefered to keep it simple.
#
###### File structure
#
# Program structure
#
snippet program
	program ${1:ProgName};
	{< Program ${1:ProgName}
	
	  (c) ${2:Year} ${3:Autor} https://${4:github.com/Example}
	}
	{$mode ObjFPC}{$H+}{$inline ON}{$WARN 6058 OFF}
	
	uses
	
	const
	
	resourcestring
	
	type
	
	{
	  ${1:ProgName} Main Program
	}
	var
	
	begin
	  ${5}
	end.
#
# Unit (generic)
#
snippet unit
	unit u${1:UnitName};
	{< Description
	
	  (c) ${2:Year} ${3:Autor} https://${4:github.com/Example}
	}
	{$mode ObjFPC}{$H+}{$inline ON}{$WARN 6058 OFF}
	
	interface
	
	uses
	
	const
	
	resourcestring
	
	type
	  $(5)
	
	implementation
	
	initialization
	
	finalization
	
	end.
#
# Unit (Class)
#
snippet unitc
	unit uc${1:ClassName};
	{< Unit of c${1:ClassName} class.
	
	  (c) ${2:Year} ${3:Autor} https://${4:github.com/Example}
	}
	{$mode ObjFPC}{$H+}{$inline ON}{$WARN 6058 OFF}
	
	interface
	
	uses
	  Generics.Collections;
	
	const
	
	resourcestring
	
	type
	
	{
	  c${1:ClassName}
	}
	
	  c${1:ClassName} = class (${5:tObject})
	  private
	
	  protected
	
	  public
	
	    constructor Create;
	    destructor Destroy; override;
	
	  end;
	
	  c${1:ClassName}GenList = specialize tObjectList<c${1:ClassName}>;
	  c${1:ClassName}List = class(c${1:ClassName}GenList);
	
	implementation

	{
	  c${1:ClassName}
	}
	
	constructor c${1:ClassName}.Create;
	begin
	  inherited Create;
	
	end;
	
	destructor c${1:ClassName}.Destroy;
	begin
	
	  inherited Destroy;
	end;
	
	initialization
	
	finalization
	
	end.
#
# Unit (Record)
#
snippet unitr
	unit ut${1:TypeName};
	{< Unit of t${1:TypeName}.
	
	  (c) ${2:Year} ${3:Autor} https://${4:github.com/Example}
	}
	{$mode ObjFPC}{$H+}{$inline ON}{$WARN 6058 OFF}
	{$MODESWITCH AdvancedRecords}
	{$MODESWITCH TypeHelpers}
	
	interface
	
	uses
	  Generics.Collections;
	
	const
	
	resourcestring
	
	type
	
	{
	  t${1:TypeName}
	}
	
	  t${1:TypeName} = ${5:packed} record
	  public
	
	    procedure Init;
	  end;
	
	  p${1:TypeName} = ^t${1:TypeName};
	
	  c${1:TypeName}GenList = specialize tList<c${1:TypeName}>;
	  c${1:TypeName}List = class(c${1:TypeName}GenList);
	
	implementation

	{
	  t${1:TypeName}
	}
	
	procedure t${1:TypeName}.Init;
	begin
	
	end;
	
	initialization
	
	finalization
	
	end.
#
#
###### Code blocks
#
# Case with otherwise.
#
snippet case
	case ${1:CaseVar} of
	  ${2:aCase1} :
	  begin
	    
	  end;
	
	  ${3:aCase2} :
	  begin
	    
	  end;
	
	otherwise // case ${1:CaseVar}
	  
	end; // case ${1:CaseVar}
	
#
# begin..end block.
#
snippet begin
	begin
	  ${1}
	end;
	
#
# for..to
#
snippet for
	for ${1:i} := ${2:0} to ${3:HighVal} do
	begin
	  aItem := aList[${1:i}];
	  ${4}
	end;
#
# for..downto
#
snippet ford
	for ${1:i} := ${2:HighVal} downto ${3:0} do
	begin
	  aItem := aList[${1:i}];
	  ${4}
	end;
#
# for..in
#
snippet forin
	for ${1:aItem} in ${2:aList} do
	begin
	  ${3}
	end;
#
# Function
#
snippet function
	function ${1:FuncName}(const ${2:aArg} : ${3:TypeArg}) : ${4:TypeFunc};
	begin
	  ${5}
	end;
	
#
# if
#
snippet if
	if (${1:aCond}) then
	begin
	  ${2}
	end;
#
# if..else
#
snippet iff
	if (${1:aCond}) then
	begin
	  ${2}
	end
	else // not ${1:aCond}
	begin
	  
	end; // if ${1:aCond}
#
# if -> Exit
#
snippet ifx
	if (${1:aCond}) then
	  Exit(${1:aResult});
#
# procedure
#
snippet procedure
	procedure ${1:ProcName}(const ${2:aArg} : ${3:TypeArg});
	begin
	  ${4}
	end;
	
#
# repeat..until
#
snippet repeat
	repeat
	  ${2}
	until ${1:aCond};
#
# Create -> try..finally & Free
#
snippet tryc
	${1:ClassVar} := ${2:ClassType}.Create;
	try
	  ${3}
	finally
	  ${1:ClassVar}.Free;
	end;
#
# try..except
#
snippet trye
	try
	  ${1}
	except
	  on E : ${2:Exception} do
	  begin
	    ${3}
	  end;
	end;
#
# try..finally
#
snippet tryf
	try
	  ${1}
	finally
	  ${2}
	end;
#
# while
#
snippet while
	while ${1:Cond} do
	begin
	  ${2}
	end;
#
# with
#
snippet with
	with ${1:aVar} do
	begin
	  ${2}
	end;
#
#
###### Type Declarations 
#
# Static array.
#
snippet arrays
	${1:ArrName}s = Array[${2:0}..${3:High}] of ${4:Type};
#
# Dynamic array.
#
snippet array
	${1:ArrName}s = Array of ${2:Type};
#
# Class
#
snippet class
	c${1:ClassName} = class(${1:tObject})
	private
	
	protected
	
	public
	  constructor Create;
	  destructor Destroy; override;
	end;
	
#
# Record
#
snippet record
	t${1:RecName} = ${2:packed} record
	  ${3}
	end;
	
	p${1:RecName} = ^t${1:RecName};
	
#
# Advanced Record
#   
#
snippet arecord
	t${1:RecName} = ${2:packed} record
	public
	  ${3}
	
	  procedure Init;
	end;
	
	p${1:RecName} = ^t${1:RecName};
	
#
# Record with variant part (and advanced)
#
#
snippet vrecord
	t${1:RecName} = ${2:packed} record
	public
	
	procedure Init;
	
    case Byte of
      0 : (${3}: ${4});
      1 : (${5}: ${6});
	end;
	
	p${1:RecName} = ^t${1:RecName};
	
#
#
###### Miscellaneous Shortcuts
#
# Default array property of a class
#
snippet propd
	property ${1:PropName}[Index : ${2:Integer}] : ${3:PropType} read Get${1:PropName} write Set${1:PropName}; default;
#
# Property read-only
#
snippet propr
	property ${1:PropName} : ${2:PropType} read Get${1:PropName};
#
# Property read/write
#
snippet proprw
	property ${1:PropName} : ${2:PropType} read F${1:PropName} write Set${1:PropName};
#
# Property write-only
#
snippet propw
	property ${1:PropName} : ${2:PropType} write Set${1:PropName};
